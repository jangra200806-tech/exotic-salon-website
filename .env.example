# =========================================================
#  .env.example
#  Is file ko copy karke ".env" banao aur apni asli values daalo:
#      copy .env.example .env        (Windows PowerShell me: Copy-Item .env.example .env)
#  .env kabhi git me commit na karo — wo .gitignore me hai.
#  Values sirf Vercel ke Environment Variables me bhi daalni hain.
# =========================================================

# Brevo SMTP page wala Login  (jaise: 8xxxxx001@smtp-brevo.com)
BREVO_LOGIN=

# Brevo SMTP page se generate ki hui SMTP key (password)
BREVO_SMTP_KEY=

# Brevo me verified sender email — email yahin se jaayegi
SENDER_EMAIL=

# Jis email par enquiry chahiye (salon ki email)
SALON_EMAIL=

# Groq AI chatbot (sirf server-side; front-end mein kabhi na daalein)
# Key banayein: https://console.groq.com/keys
# .env save karne ke baad server restart karein.
GROQ_API_KEY=
GROQ_MODEL=

# Optional: production me GET /api/chat?health=1 diagnostic enable karne ke liye 1
# (NODE_ENV production na ho to health apne aap enabled rehta hai.)
DEBUG_CHAT=
